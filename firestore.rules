rules_version = '2';

// One set of rules for every app sharing ai-foundation-firebase (AI Foundation, the LMS, token-kit apps,
// GCourse Builder and others). Deploy only from the AI Foundation folder:
//   firebase deploy --only firestore:rules --project ai-foundation-firebase
// An app's own collections carry its tag as a prefix (aifoundation_token_checkouts, gcoursebuilder_roles), so no
// two apps share a collection by accident. The SuperAdmin is the owner in every app (isSuperAdmin, from the sign-in);
// every other role and permission belongs to one app, in its own collections. List each new collection in
// isProtectedCollection, with its own rules.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // SuperAdmins: matched by UID, or by email only when Google has verified that email
    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.uid in ['ZK79FRQoVlYhsgvMibhi81dRUWj2', 'L5euSJAfNKdDOX6mT0qmrCGjUA53'] ||
        (request.auth.token.email_verified == true && request.auth.token.email in [
          'support@aifoundation.net.au',
          'davidrobertson.info@gmail.com'
        ]) ||
        (exists(/databases/$(database)/documents/admins/admin_emails) &&
         request.auth.token.get('email_verified', false) == true &&
         request.auth.token.get('email', '') in get(/databases/$(database)/documents/admins/admin_emails).data.get('emails', []))
      );
    }

    // Admins: SuperAdmins, or users whose profile role was set to admin by a SuperAdmin / the server
    function isAdmin() {
      return isSuperAdmin() || (
        isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['admin', 'super_admin', 'superadmin', 'chiefadmin']
      );
    }

    // Tenant partition check for multi-tenant isolation (tag, businessId, source).
    // Verifies existing documents on reads/updates/deletes and resulting documents on creates/updates.
    // Allows both legacy 'aifoundation' and migrated '#aifoundation' businessId values while preventing cross-tenant spoofing.
    function docMatchesPartition(docData, expectedTag) {
      return docData.get('tag', '') == expectedTag
        && (!('businessId' in docData) || docData.businessId in [expectedTag, '#' + expectedTag])
        && (!('source' in docData) || docData.source == expectedTag);
    }

    function partitionMatches(expectedTag) {
      return (request.method == 'create' || (resource != null && docMatchesPartition(resource.data, expectedTag)))
        && (!(request.method in ['create', 'update']) || docMatchesPartition(request.resource.data, expectedTag));
    }

    // Collections holding PII or authorization data. Excluded from the catch-all rule below,
    // because Firestore rules are OR'd and a broad match would otherwise override these.
    function isProtectedCollection(name) {
      return name in ['users', 'transactions', 'stripe_transactions', 'paypal_transactions',
                      'chat_interactions', 'system_settings', 'admins', 'content',
                      'token_ledger', 'aifoundation_token_checkouts', 'token_checkouts',
                      'aifoundation_strategy_sessions', 'aifoundation_strategy_superadmin_briefs',
                      'aifoundation_regional_edu_sessions', 'aifoundation_regional_edu_reviews',
                      'aifoundation_tool_governance_sessions', 'aifoundation_tool_governance_reviews',
                      'aifoundation_managed_agent_sessions', 'aifoundation_managed_agent_reviews',
                      'gcoursebuilder_roles', 'gcoursebuilder_role_assignments',
                      'hr_users', 'hr_candidate_profiles', 'hr_candidate_unlocks', 'hr_agent_resumes',
                      'hr_agent_inquiries', 'hr_recruitment_audit_logs', 'hr_conversations', 'hr_employers',
                      'hr_registrations', 'hr_settings', 'hr_rbac_audit_log'];
    }

    // Profile fields that grant privileges or hold value; users can never set or change these themselves.
    // token_balance is the token balance every app shares: only servers change it (service account)
    function privilegedFields() {
      return ['role', 'status', 'classification', 'isSuperAdmin', 'isAdmin', 'tags',
              'token_balance', 'token_balance_updated_at'];
    }

    // AI Foundation Content (Articles, Projects, Tech, Community)
    // Anyone can read public content; only admins can publish, edit or delete
    match /content/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User Profiles (PII): readable by the owner and admins only
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isSuperAdmin() || (
        isOwner(userId) &&
        request.resource.data.get('role', 'supporter') == 'supporter' &&
        request.resource.data.get('status', 'supporter') == 'supporter' &&
        request.resource.data.get('isSuperAdmin', false) == false &&
        request.resource.data.get('isAdmin', false) == false &&
        request.resource.data.get('token_balance', 0) == 0 &&
        !request.resource.data.keys().hasAny(['tags', 'token_balance_updated_at'])
      );
      allow update: if isSuperAdmin() || (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(privilegedFields())
      );
      allow delete: if isSuperAdmin();
    }

    // Transactions / Checkout Records (PII): written only by the server (service account)
    match /{txCollection}/{txId} {
      allow read: if txCollection in ['stripe_transactions', 'paypal_transactions'] && isAdmin();
      allow write: if false;
    }
    match /transactions/{txId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Supporter Chat & Administrative Messaging (Multi-Tenant)
    // - Supporters can only send as themselves
    // - SuperAdmin can read all messages from ALL tenants
    // - Normal supporters can ONLY read their own messages
    // - Only SuperAdmin can delete or modify records
    match /chat_interactions/{msgId} {
      allow create: if isAuthenticated() && request.resource.data.senderUid == request.auth.uid;
      allow read: if isSuperAdmin() || (
        isAuthenticated() && (
          request.auth.uid == resource.data.senderUid ||
          request.auth.uid == resource.data.recipientUid
        )
      );
      allow update, delete: if isSuperAdmin();
    }

    // Token ledger: one entry per change to a token balance (purchase, grant or spend). Users read their own entries;
    // only servers write them (service account), in the same commit as the balance change
    match /token_ledger/{entryId} {
      allow read: if (isAuthenticated() && resource.data.uid == request.auth.uid) || isAdmin();
      allow write: if false;
    }

    // Token checkouts not paid yet (Buy Tokens): server only, readable by the owner and admins
    match /aifoundation_token_checkouts/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;
    }
    // The same for the owner's other apps (token-kit), one document per app and user: {appTag}_{uid}
    match /token_checkouts/{docId} {
      allow read: if (isAuthenticated() && resource.data.uid == request.auth.uid) || isAdmin();
      allow write: if false;
    }

    // Admin email lists used for authorization (PII)
    match /system_settings/{docId} {
      allow read, write: if isSuperAdmin();
    }
    match /admins/{docId} {
      allow read, write: if isSuperAdmin();
    }

    // GCourse Builder (tag gcoursebuilder): role-based access control, from the app's firestore.rules (which its
    // emulator tests use). Its profiles follow the users rules above.
    // The SuperAdmin is the owner, as in every app: isSuperAdmin() above, from the sign-in's UID or verified email.
    // Every other role is the app's own: the role the SuperAdmin gave the person's verified email in
    // gcoursebuilder_role_assignments, else supporter. What a role may do is the permissions list in
    // gcoursebuilder_roles/{role}. gcbRoleKeys() and gcbPermissionKeys() must match the app's src/rbac/permissions.js.
    function gcbHasVerifiedEmail() {
      return request.auth.token.get('email', '') != ''
        && request.auth.token.get('email_verified', false) == true;
    }

    // Only call after gcbHasVerifiedEmail()
    function gcbAssignmentPath() {
      return /databases/$(database)/documents/gcoursebuilder_role_assignments/$(request.auth.token.email.lower());
    }

    function gcbRoleGrants(role, perm) {
      return exists(/databases/$(database)/documents/gcoursebuilder_roles/$(role))
        && perm in get(/databases/$(database)/documents/gcoursebuilder_roles/$(role)).data.permissions;
    }

    // The role assigned to the verified email, else supporter
    function gcbAssignedRoleGrants(perm) {
      return (gcbHasVerifiedEmail() && exists(gcbAssignmentPath())
          && gcbRoleGrants(get(gcbAssignmentPath()).data.role, perm))
        || (!(gcbHasVerifiedEmail() && exists(gcbAssignmentPath())) && gcbRoleGrants('supporter', perm));
    }

    // True when the signed-in user's role includes perm. The SuperAdmin holds every permission
    function gcbHasPermission(perm) {
      return isAuthenticated() && (isSuperAdmin() || gcbAssignedRoleGrants(perm));
    }

    function gcbRoleKeys() {
      return ['superadmin', 'chiefadmin', 'administration', 'chancellor', 'president', 'ceo', 'coo', 'cfo', 'accounting',
              'teacher', 'student', 'supporter'];
    }

    function gcbPermissionKeys() {
      return [
        'courses.view', 'courses.create', 'courses.publish', 'grades.view', 'grades.edit', 'classroom.manage',
        'applications.view', 'applications.review', 'applications.export', 'students.manage',
        'finance.view', 'finance.approve', 'tokens.manage', 'events.manage', 'calendar.manage',
        'ai.customize', 'faqs.edit', 'messaging.staff', 'telemetry.view',
        'users.manage', 'roles.manage', 'sheets.sync', 'api_keys.manage', 'campus_metrics.manage'
      ];
    }

    // { roleName, permissions, updatedAt, updatedBy }, stamped by the writer at the server's time.
    // The superadmin role must keep every permission, so it can't be locked out
    function gcbIsValidRoleDoc(roleId) {
      let data = request.resource.data;
      return roleId in gcbRoleKeys()
        && data.keys().hasAll(['roleName', 'permissions', 'updatedAt', 'updatedBy'])
        && data.keys().hasOnly(['roleName', 'permissions', 'updatedAt', 'updatedBy'])
        && data.roleName is string && data.roleName.size() > 0 && data.roleName.size() <= 60
        && data.permissions is list
        && data.permissions.size() <= gcbPermissionKeys().size()
        && data.permissions.toSet().size() == data.permissions.size()
        && data.permissions.hasOnly(gcbPermissionKeys())
        && (roleId != 'superadmin' || data.permissions.hasAll(gcbPermissionKeys()))
        && data.updatedAt == request.time
        && data.updatedBy == request.auth.uid;
    }

    // { email, role, assignedAt, assignedBy } at the lower-case email. Superadmin is never assigned: it is the owner
    function gcbIsValidAssignment(email) {
      let data = request.resource.data;
      return email == email.lower()
        && email.matches('[^@ /]+@[^@ /]+[.][^@ /]+')
        && data.keys().hasAll(['email', 'role', 'assignedAt', 'assignedBy'])
        && data.keys().hasOnly(['email', 'role', 'assignedAt', 'assignedBy'])
        && data.email == email
        && data.role in gcbRoleKeys()
        && data.role != 'superadmin'
        && data.assignedAt == request.time
        && data.assignedBy == request.auth.uid;
    }

    // Role permissions: readable when signed in, written by SuperAdmin, or by users holding roles.manage
    // (such as Chief Admin) for all roles except superadmin.
    match /gcoursebuilder_roles/{roleId} {
      allow read: if isAuthenticated();
      allow create, update: if (isSuperAdmin() || (gcbHasPermission('roles.manage') && roleId != 'superadmin'))
        && gcbIsValidRoleDoc(roleId);
      allow delete: if false;
    }

    // Roles given to email addresses: people can read their own; SuperAdmin and users with users.manage
    // (such as Chief Admin) can assign all roles except superadmin.
    match /gcoursebuilder_role_assignments/{email} {
      allow read: if isSuperAdmin()
        || gcbHasPermission('users.manage')
        || (isAuthenticated() && gcbHasVerifiedEmail() && request.auth.token.email.lower() == email);
      allow create, update: if (isSuperAdmin() || gcbHasPermission('users.manage'))
        && gcbIsValidAssignment(email);
      allow delete: if isSuperAdmin() || gcbHasPermission('users.manage');
    }

    // What HR Agency (tag hr): User profiles, RBAC roles, and candidate talent pool. A new profile is a supporter; the
    // other roles (Company, HR Agent, Main Admin, SuperAdmin) are given only by the HR server, once a SuperAdmin approves
    // the person's registration or gives the role (lib/registrations.js, lib/role-assignment.js), so nobody changes
    // their own role. JobSeeker comes only from a SuperAdmin approving the person's resume on the HR server: not even a
    // SuperAdmin adds it from the app
    function hrAddsJobseeker() {
      return (request.resource.data.get('role', '') == 'jobseeker' && (resource == null || resource.data.get('role', '') != 'jobseeker')) ||
        ('jobseeker' in request.resource.data.get('roles', []) && (resource == null || !('jobseeker' in resource.data.get('roles', []))));
    }

    match /hr_users/{userId} {
      allow read: if isOwner(userId) || isSuperAdmin() || isAdmin();
      allow create: if (isSuperAdmin() && !hrAddsJobseeker()) || (
        isOwner(userId) &&
        request.resource.data.get('role', 'supporter') == 'supporter' &&
        request.resource.data.get('roles', ['supporter']) == ['supporter'] &&
        request.resource.data.get('isAdmin', false) == false &&
        request.resource.data.get('isSuperAdmin', false) == false &&
        !request.resource.data.keys().hasAny(['isMainAdmin', 'employerCompanyName', 'hrAgentAgencyName'])
      );
      allow update: if (isSuperAdmin() && !hrAddsJobseeker()) || (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'roles', 'isAdmin', 'isSuperAdmin', 'isMainAdmin', 'employerCompanyName', 'hrAgentAgencyName'
        ])
      );
      allow delete: if isSuperAdmin();
    }

    // Candidate profiles hold the contact details companies and HR Agents pay tokens to unlock, so only the candidate
    // and admins read them here. Everyone else gets them from the HR app's server (lib/candidate-access.js), which
    // shows the locked view until the profile is unlocked with tokens. A profile is at its candidate's uid; older
    // profiles at a random ID are matched by their uid or registeredUserUid field
    function isHrCandidateOwner(profileId) {
      return profileId == request.auth.uid ||
        resource.data.get('uid', '') == request.auth.uid ||
        resource.data.get('registeredUserUid', '') == request.auth.uid;
    }

    match /hr_candidate_profiles/{profileId} {
      allow read: if isAuthenticated() && (isHrCandidateOwner(profileId) || isSuperAdmin() || isAdmin());
      // Written only by the HR app's server: saved after the upload fee (lib/resume-profiles.js), put in search only when
      // a SuperAdmin approves the jobseeker (lib/registrations.js), edited by a SuperAdmin there (lib/admin-resumes.js).
      // Nobody writes one from the app, not even a SuperAdmin
      allow create, update: if false;
      allow delete: if isAuthenticated() && (
        resource.data.get('uid', profileId) == request.auth.uid || isSuperAdmin() || isAdmin()
      );
    }

    // Which candidate profiles each company or HR Agent has unlocked: written only by the HR app's server, after it
    // has taken the tokens
    match /hr_candidate_unlocks/{viewerUid} {
      allow read: if isOwner(viewerUid) || isAdmin();
      allow write: if false;
    }

    // HR Agent resume pool (with the full resume text) and company inquiries to agents: written only by the server
    match /hr_agent_resumes/{resumeId} {
      allow read: if isAuthenticated() && (resource.data.get('agentId', '') == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /hr_agent_inquiries/{inquiryId} {
      allow read: if isAuthenticated() && (
        resource.data.get('companyUid', '') == request.auth.uid ||
        resource.data.get('agentId', '') == request.auth.uid ||
        isAdmin()
      );
      allow write: if false;
    }

    // Companies registered with What HR (company name, ABN and contact details), recorded by the HR server when a
    // SuperAdmin approves the company's registration (lib/registrations.js): each company sees its own; admins see them all
    match /hr_employers/{companyUid} {
      allow read: if isOwner(companyUid) || isAdmin();
      allow create, update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // Registrations as a Jobseeker, Company or HR Agent, waiting for (or decided by) a SuperAdmin: only the HR app's
    // server reads and writes them (lib/registrations.js)
    match /hr_registrations/{registrationId} {
      allow read, write: if false;
    }

    // What HR's settings, Free This Minute! (hr_settings/free_this_minute) and the countries banned from registering
    // (hr_settings/registration_countries): only the HR app's server reads and writes them. A SuperAdmin turns Free This
    // Minute! on through the server (PUT /api/admin/free-this-minute, lib/free-this-minute.js), which always makes it
    // 15 minutes; nobody writes them from the app, not even a SuperAdmin
    match /hr_settings/{settingId} {
      allow read, write: if false;
    }

    // Messages between companies or HR Agents and the jobseekers whose resumes they unlocked (and the jobseekers' details):
    // only the HR app's server reads and writes them (lib/messages.js). Nobody can change or delete a message; each is kept
    // for 7 years
    match /hr_conversations/{conversationId}/{rest=**} {
      allow read, write: if false;
    }

    // Audit log of candidate profile saves: people add entries about themselves; only admins read them
    match /hr_recruitment_audit_logs/{logId} {
      allow create: if isAuthenticated() && request.resource.data.get('userUid', '') == request.auth.uid;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Log of roles given in What HR's RBAC panel (who gave whom which role, and why): written only by the HR app's
    // server (lib/role-assignment.js); only admins read it
    match /hr_rbac_audit_log/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ===============================================================
    // Google AI Strategy & First-Month Plan (Advisory-Only Service)
    // ===============================================================
    // Assumed Data Model (see strategy-plan.d.ts):
    // - Collection: aifoundation_strategy_sessions/{sessionId}
    //   Fields: id, tag, businessId, businessName, source, uid, userEmail, userName,
    //   stripeSessionId, paymentStatus, amountPaidExGstAud, currency, status,
    //   currentStep, totalSteps, clientBusinessName, nicheGroundingSummary,
    //   answers, messages, preliminaryReport, superadminBriefId, createdAt, updatedAt
    //   Written exclusively by the backend server (Firebase Service Account).
    // - Collection: aifoundation_strategy_superadmin_briefs/{briefId}
    //   Fields: id, tag, businessId, businessName, source, strategySessionId,
    //   stripeSessionId, uid, clientEmail, clientBusinessName, amountPaidExGstAud,
    //   fileName, summary, content, read (bool), modelUsed, createdAt, updatedAt
    //   Created exclusively by the backend server (Firebase Service Account);
    //   SuperAdmins may read, mark read (read/updatedAt only), or delete.
    function isValidStrategyBriefUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['read', 'updatedAt'])
        && (!changed.hasAny(['read']) || (
          'read' in request.resource.data && request.resource.data.read is bool
        ))
        && (!changed.hasAny(['updatedAt']) || (
          'updatedAt' in request.resource.data && (
            request.resource.data.updatedAt is timestamp ||
            (request.resource.data.updatedAt is string &&
             request.resource.data.updatedAt.size() > 0 &&
             request.resource.data.updatedAt.size() <= 64)
          )
        ));
    }

    // Strategy sessions: only the backend server (Firebase Service Account) writes/updates
    // strategy sessions, enforcing payment gating, secret redaction, and the 6-step state machine
    match /aifoundation_strategy_sessions/{sessionId} {
      allow read: if isSuperAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    // SuperAdmin strategy briefs: only the backend server (Firebase Service Account) creates briefs;
    // strictly authenticated SuperAdmins may read, mark read, or delete them
    match /aifoundation_strategy_superadmin_briefs/{briefId} {
      allow read, delete: if isSuperAdmin();
      allow create: if false;
      allow update: if isSuperAdmin() && isValidStrategyBriefUpdate();
    }

    // ===============================================================
    // Regional Education & AI Literacy (Advisory-Only Service)
    // ===============================================================
    // Assumed Data Model (see regional-edu-plan.d.ts):
    // - Collection: aifoundation_regional_edu_sessions/{sessionId}
    //   Fields: id, tag, businessId, businessName, source, uid (or userId), userEmail, userName,
    //   stripeSessionId, paymentStatus, amountPaidExGstAud, currency, status,
    //   currentStep, totalSteps, clientOrganizationName, regionGroundingSummary,
    //   needsSummary, answers, messages, preliminaryReport, finalImprovedReport,
    //   superadminExecutiveNote, superadminReviewId, superadminApprovedAt,
    //   createdAt, updatedAt
    //   Written exclusively by the backend server (Firebase Admin SDK / REST Service Account).
    // - Collection: aifoundation_regional_edu_reviews/{reviewId}
    //   Fields: id, tag, businessId, businessName, source, regionalEduSessionId,
    //   stripeSessionId, uid, clientEmail, clientOrganizationName, amountPaidExGstAud,
    //   reviewStatus ('unread_analysis' | 'in_review_editing' | 'final_improved_delivered'),
    //   read (bool), summary, needsSummary, intakeTranscript, researchSummary,
    //   preliminaryFileName, preliminaryTxtContent, workingDraftContent,
    //   superadminNote, finalFileName, finalTxtContent, approvedAt, modelUsed,
    //   createdAt, updatedAt
    //   Created exclusively by the backend server after Stage 2 async research;
    //   SuperAdmins may read, update draft/approval fields within the 'aifoundation' partition, or delete.
    function isValidRegionalEduTimestampOrIso(val) {
      return val is timestamp ||
        (val is string && val.size() > 0 && val.size() <= 64);
    }

    function isValidRegionalEduReviewStatusTransition(prevStatus, nextStatus) {
      return (prevStatus == 'unread_analysis' && nextStatus in ['unread_analysis', 'in_review_editing', 'final_improved_delivered']) ||
        (prevStatus == 'in_review_editing' && nextStatus in ['in_review_editing', 'final_improved_delivered']) ||
        (prevStatus == 'final_improved_delivered' && nextStatus == 'final_improved_delivered');
    }

    function isValidBaseAdvisoryReviewFields(changed) {
      return (!changed.hasAny(['read']) || (
          'read' in request.resource.data && request.resource.data.read is bool
        ))
        && (!changed.hasAny(['reviewStatus']) || (
          'reviewStatus' in request.resource.data &&
          request.resource.data.reviewStatus is string &&
          request.resource.data.reviewStatus in ['unread_analysis', 'in_review_editing', 'final_improved_delivered'] &&
          (!('reviewStatus' in resource.data) ||
           isValidRegionalEduReviewStatusTransition(resource.data.reviewStatus, request.resource.data.reviewStatus))
        ))
        && (!changed.hasAny(['workingDraftContent']) || (
          'workingDraftContent' in request.resource.data &&
          request.resource.data.workingDraftContent is string &&
          request.resource.data.workingDraftContent.size() > 0 &&
          request.resource.data.workingDraftContent.size() <= 80000
        ))
        && (!changed.hasAny(['superadminNote']) || (
          'superadminNote' in request.resource.data &&
          request.resource.data.superadminNote is string &&
          request.resource.data.superadminNote.size() <= 4000
        ))
        && (!changed.hasAny(['finalFileName']) || (
          'finalFileName' in request.resource.data && (
            request.resource.data.finalFileName == null ||
            (request.resource.data.finalFileName is string &&
             request.resource.data.finalFileName.size() > 0 &&
             request.resource.data.finalFileName.size() <= 200)
          )
        ))
        && (!changed.hasAny(['finalTxtContent']) || (
          'finalTxtContent' in request.resource.data && (
            request.resource.data.finalTxtContent == null ||
            (request.resource.data.finalTxtContent is string &&
             request.resource.data.finalTxtContent.size() > 0 &&
             request.resource.data.finalTxtContent.size() <= 80000)
          )
        ))
        && (!changed.hasAny(['approvedAt']) || (
          'approvedAt' in request.resource.data && (
            request.resource.data.approvedAt == null ||
            isValidRegionalEduTimestampOrIso(request.resource.data.approvedAt)
          )
        ))
        && (!changed.hasAny(['updatedAt']) || (
          'updatedAt' in request.resource.data &&
          isValidRegionalEduTimestampOrIso(request.resource.data.updatedAt)
        ));
    }

    function isValidRegionalEduReviewUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly([
          'read', 'reviewStatus', 'workingDraftContent', 'superadminNote',
          'finalFileName', 'finalTxtContent', 'approvedAt', 'updatedAt'
        ])
        && isValidBaseAdvisoryReviewFields(changed);
    }

    // Regional Education sessions: strictly readable by SuperAdmin or the owning authenticated user
    // within the 'aifoundation' partition (supports both `userId` and `uid` session owner fields);
    // all writes go exclusively through the backend server (Firebase Admin SDK / REST Service Account)
    match /aifoundation_regional_edu_sessions/{sessionId} {
      allow read: if isSuperAdmin() || (
        isAuthenticated() &&
        partitionMatches('aifoundation') &&
        (resource.data.get('userId', '') == request.auth.uid || resource.data.get('uid', '') == request.auth.uid)
      );
      allow create, update, delete: if false;
    }

    // Regional Education SuperAdmin reviews: created only by the backend server after Stage 2 async research;
    // strictly SuperAdmin read/delete, and SuperAdmin update constrained to 'aifoundation' partition + valid fields
    match /aifoundation_regional_edu_reviews/{reviewId} {
      allow read: if isSuperAdmin();
      allow create: if false;
      allow update: if isSuperAdmin() && partitionMatches('aifoundation') && isValidRegionalEduReviewUpdate();
      allow delete: if isSuperAdmin();
    }

    // ===============================================================
    // Services 3 & 4: Tool Governance & Managed Agent Advisory Services
    // ===============================================================
    // Assumed Data Model:
    // - Collection: aifoundation_tool_governance_sessions/{sessionId}
    // - Collection: aifoundation_managed_agent_sessions/{sessionId}
    //   Fields: id, tag ('aifoundation'), businessId ('aifoundation' | '#aifoundation'),
    //   businessName, source ('aifoundation'), uid (or userId), userEmail, userName,
    //   stripeSessionId, paymentStatus, amountPaidExGstAud, currency, status,
    //   currentStep, totalSteps, answers, messages, preliminaryReport,
    //   finalImprovedReport, superadminExecutiveNote, superadminReviewId,
    //   superadminApprovedAt, createdAt, updatedAt
    //   Written exclusively by the backend server (Firebase Admin SDK / REST Service Account).
    // - Collection: aifoundation_tool_governance_reviews/{reviewId}
    // - Collection: aifoundation_managed_agent_reviews/{reviewId}
    //   Fields: id, tag ('aifoundation'), businessId ('aifoundation' | '#aifoundation'),
    //   businessName, source ('aifoundation'), sessionId, stripeSessionId, uid,
    //   clientEmail, clientOrganizationName, amountPaidExGstAud,
    //   reviewStatus ('unread_analysis' | 'in_review_editing' | 'final_improved_delivered'),
    //   read (bool), summary, needsSummary, intakeTranscript, researchSummary,
    //   preliminaryFileName, preliminaryTxtContent, workingDraftContent,
    //   superadminNote, finalFileName, finalTxtContent, approvedAt,
    //   reviewedByUid (optional string <= 128), reviewedAt (optional timestamp | ISO string <= 64),
    //   modelUsed, createdAt, updatedAt
    //   Created exclusively by the backend server; SuperAdmins may read, update
    //   draft/approval/review-metadata fields within the 'aifoundation' partition, or delete.
    function isValidAdvisorySessionOwnerRead() {
      return isSuperAdmin() || (
        isAuthenticated() &&
        partitionMatches('aifoundation') &&
        (resource.data.get('userId', '') == request.auth.uid || resource.data.get('uid', '') == request.auth.uid)
      );
    }

    function isValidAdvisoryReviewUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly([
          'read', 'reviewStatus', 'workingDraftContent', 'superadminNote',
          'finalFileName', 'finalTxtContent', 'approvedAt', 'updatedAt',
          'reviewedByUid', 'reviewedAt'
        ])
        && isValidBaseAdvisoryReviewFields(changed)
        && (!changed.hasAny(['reviewedByUid']) || (
          'reviewedByUid' in request.resource.data &&
          request.resource.data.reviewedByUid is string &&
          request.resource.data.reviewedByUid.size() > 0 &&
          request.resource.data.reviewedByUid.size() <= 128
        ))
        && (!changed.hasAny(['reviewedAt']) || (
          'reviewedAt' in request.resource.data &&
          isValidRegionalEduTimestampOrIso(request.resource.data.reviewedAt)
        ));
    }

    // Service 3: Tool Governance sessions (server writes only; owner or SuperAdmin read)
    match /aifoundation_tool_governance_sessions/{sessionId} {
      allow read: if isValidAdvisorySessionOwnerRead();
      allow create, update, delete: if false;
    }

    // Service 3: Tool Governance SuperAdmin reviews (server creates; SuperAdmin read/update/delete)
    match /aifoundation_tool_governance_reviews/{reviewId} {
      allow read: if isSuperAdmin();
      allow create: if false;
      allow update: if isSuperAdmin() && partitionMatches('aifoundation') && isValidAdvisoryReviewUpdate();
      allow delete: if isSuperAdmin();
    }

    // Service 4: Managed Agent sessions (server writes only; owner or SuperAdmin read)
    match /aifoundation_managed_agent_sessions/{sessionId} {
      allow read: if isValidAdvisorySessionOwnerRead();
      allow create, update, delete: if false;
    }

    // Service 4: Managed Agent SuperAdmin reviews (server creates; SuperAdmin read/update/delete)
    match /aifoundation_managed_agent_reviews/{reviewId} {
      allow read: if isSuperAdmin();
      allow create: if false;
      allow update: if isSuperAdmin() && partitionMatches('aifoundation') && isValidAdvisoryReviewUpdate();
      allow delete: if isSuperAdmin();
    }

    // Fallback for other tenants' collections (unchanged behaviour),
    // excluding the protected collections above
    match /{collectionName}/{document=**} {
      allow read: if !isProtectedCollection(collectionName);
      allow write: if isAuthenticated() && !isProtectedCollection(collectionName);
    }
  }
}
