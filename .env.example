# ImgBB API Configuration
IMGBB_API_KEY=your_imgbb_api_key_here
IMGBB_ALBUM_ID=your_imgbb_album_id_here

# Stripe Payment Gateway
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# PayPal Integration
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here

# Firebase Cloud Firestore & Authentication
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PROJECT_NAME="Your Project Name"
FIREBASE_PROJECT_NUMBER=123456789000
FIREBASE_API_KEY=your_firebase_web_api_key_here
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=123456789000
FIREBASE_APP_ID=1:123456789000:web:abcdef123456
BUSINESS_ID=aifoundation
TRANSACTION_TAG=aifoundation

# Firebase Admin Service Account Credentials
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@your-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
