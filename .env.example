# ImgBB API Configuration
IMGBB_API_KEY=your_imgbb_api_key_here
IMGBB_ALBUM_ID=your_imgbb_album_id_here

# Stripe Payment Gateway
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
# No Stripe webhooks and no STRIPE_WEBHOOK_SECRET: each Checkout Session is saved as pending before the redirect and
# verified with stripe.checkout.sessions.retrieve() on return, on reload, or by SuperAdmin -> Token Accounts ->
# Verify pending payments. Stripe MCP is for developer and admin work only.

# Firebase Cloud Firestore & Authentication
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PROJECT_NAME="Your Project Name"
FIREBASE_PROJECT_NUMBER=123456789000
FIREBASE_API_KEY=your_firebase_web_api_key_here
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=123456789000
FIREBASE_APP_ID=1:123456789000:web:abcdef123456
BUSINESS_ID="#aifoundation"
TRANSACTION_TAG=aifoundation

# Firebase Admin Service Account Credentials
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@your-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Tokens: your other apps' sites that may read and spend users' tokens from the browser (comma separated, optional)
TOKEN_API_ORIGINS=https://lms.example.com,https://another-app.example.com

# AI & Gemini API Configuration (AI Skills)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-4-hydrogen
AI_SKILLS_ENABLED=true

# Paid AI service prices (AUD cents, ex GST): FALLBACKS ONLY. Checkout charges the price set in
# SuperAdmin -> Services & Pricing, read fresh on every checkout. These apply only when no admin price is
# found in Firestore or data/service-prices.json. Change prices in the admin panel, not here.
STRATEGY_PLAN_PRICE_AUD_CENTS=29900
REGIONAL_EDU_PLAN_PRICE_AUD_CENTS=19900
AI_TOOL_GOVERNANCE_PRICE_AUD_CENTS=39900
MANAGED_AGENT_ADVISORY_PRICE_AUD_CENTS=34900
