# Copy to .env for local development (.env must be in .gitignore). Add the same names in Vercel:
# Project -> Settings -> Environment Variables. Mark STRIPE_SECRET_KEY and FIREBASE_PRIVATE_KEY as Sensitive.

# This app: its tag (lower case letters, numbers, - or _) and display name. Goes on every record it writes
APP_TAG=myapp
APP_NAME="My App"

# Stripe (same account as AI Foundation). Test keys start sk_test_, live keys sk_live_
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Firebase: the shared project every app uses
FIREBASE_PROJECT_ID=ai-foundation-firebase
FIREBASE_API_KEY=your_firebase_web_api_key_here
FIREBASE_AUTH_DOMAIN=ai-foundation-firebase.firebaseapp.com
FIREBASE_STORAGE_BUCKET=ai-foundation-firebase.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=614773274800
FIREBASE_APP_ID=your_firebase_web_app_id_here

# Firebase service account (server only, never in the browser or in git)
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@ai-foundation-firebase.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Optional: other apps' sites that may read and spend tokens from the browser (comma separated)
TOKEN_API_ORIGINS=
